flowchart TD
  subgraph ingress[Ingress]
    Proxy[Load<br>Balancer]
    WAF{Allowed?}
  end
  Proxy --> WAF
  WAF -->|yes| App[Application]
  WAF -->|no| Reject((Rejected))
  classDef hot fill:#ffe0b2,stroke:#ef6c00,color:#111
  class Proxy,App hot

